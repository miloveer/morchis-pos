rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function staff() { return signedIn() && profile().activo == true && profile().rol in ['socio', 'empleada']; }
    function partner() { return signedIn() && profile().activo == true && profile().rol == 'socio'; }

    match /menu/{document=**} {
      allow read: if true;
      allow write: if staff();
    }

    match /catalogos/{document=**} {
      allow read: if true;
      allow write: if staff();
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || partner());
      allow write: if partner();
    }

    match /pedidos/{document=**} { allow read, write: if staff(); }
    match /cajas/{document=**} { allow read, write: if staff(); }
    match /inventario/operacion/insumos/{insumoId} {
      function fichaValida(i) {
        let campos = ['nombre', 'tienda', 'presentacion', 'stock', 'minimo', 'comprado',
          'registradoPor', 'registradoNombre', 'registradoColor', 'registradoEn'];
        return i.keys().hasOnly(campos.concat(['cantidadCompra', 'foto'])) && i.keys().hasAll(campos)
          && i.nombre is string && i.nombre.size() > 0 && i.nombre.size() <= 120
          && i.tienda is string && i.tienda.size() > 0 && i.tienda.size() <= 120
          && i.presentacion is string && i.presentacion.size() > 0 && i.presentacion.size() <= 80
          && i.stock is number && i.stock >= 0 && i.stock <= 1000000
          && i.minimo is number && i.minimo >= 0 && i.minimo <= 1000000
          && i.comprado is bool
          && (!('cantidadCompra' in i) || (i.cantidadCompra is number
            && i.cantidadCompra >= 0 && i.cantidadCompra <= 1000000))
          && (!('foto' in i) || (i.foto is string && i.foto.size() > 23
            && i.foto.size() <= 98304 && i.foto.matches('data:image/jpeg;base64,.*')));
      }
      function firmaActual(i) {
        let datos = profile();
        let nombre = datos.get('nombre', '');
        let color = datos.get('colorInventario', 'gris');
        return i.registradoPor == request.auth.uid
          && i.registradoNombre == (nombre == '' ? 'Personal' : nombre)
          && i.registradoColor == (color in ['rojo', 'morado', 'rosa', 'amarillo', 'gris'] ? color : 'gris')
          && i.registradoEn == request.time;
      }
      allow read: if staff();
      allow create: if staff() && fichaValida(request.resource.data)
        && request.resource.data.comprado == false && firmaActual(request.resource.data);
      allow update: if staff() && fichaValida(request.resource.data) && (
        (firmaActual(request.resource.data)
          && (!request.resource.data.comprado || resource.data.comprado == true))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comprado'])
          && (resource.data.get('cantidadCompra', resource.data.minimo - resource.data.stock) > 0))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidadCompra', 'comprado'])
          && 'cantidadCompra' in request.resource.data && request.resource.data.comprado == false)
      );
    }
    match /costos/{document=**} { allow read, write: if partner(); }
    match /reportes/{document=**} { allow read: if partner(); allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
